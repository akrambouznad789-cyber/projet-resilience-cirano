{
  "$description": "Jetons de design des pages du projet CIRANO (Volets 1, 2 et 3). Format DTCG ($value, $type), importable tel quel par Style Dictionary 4. Source unique : scripts/theme_pages.py en tire theme.css et palette.js. Thème sombre par défaut (inspiré de Dracula), thème clair conservé (data-theme=\"clair\"). Palettes de données validées par le validateur du skill dataviz (contraste, daltonisme) contre la terre de chaque thème.",
  "interface": {
    "sombre": {
      "bg":          { "$type": "color", "$value": "#191a21", "$description": "fond de page" },
      "panel":       { "$type": "color", "$value": "#21222c", "$description": "colonne des étapes, tuiles" },
      "card":        { "$type": "color", "$value": "#282a36", "$description": "panneau, cartes, infobulles" },
